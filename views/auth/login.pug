extends ../layout/index
block contenido 
    div.py-10 
        h1.text-4xl.my-10.font-extrabold.text-center Isi 
            span.font-normal Office    
        h2.text-center.text-2xl.font-extrabold= pagina
        if(errores)
            div.max-w-md.mx-auto.my-10
                each error in errores
                    p.bg-red-600.text-white.uppercase.text-xs.text-center.p-2.mb-1.font-bold= error.msg
        .mt-8.mx-auto.max-w-md
            .bg-white.py-8.px-4.shadow
                form.space-y-5(method= "POST" action="/auth/login" noValidate)
                    input(type="hidden" name="_csrf" value= csrfToken)
                    div
                        label.block.text-sm.uppercase.text-gray-600.mb-3.font-bold(for="email") Email
                        input#email.w-full.px-3.py-2.border.border-gray-300.rounded-md.placeholder-gray-400(placeholder="Tu Email" type="email" name="email") 
                    div
                        label.block.text-sm.uppercase.text-gray-600.mb-3.font-bold(for="password") Contraseña
                        div.relative
                            input#password.w-full.px-3.py-2.pr-10.border.border-gray-300.rounded-md.placeholder-gray-400(placeholder="Tu Contraseña" type="password" name="password")
                            button#togglePassword.absolute.inset-y-0.right-0.pr-3.flex.items-center.text-gray-400.hover_text-gray-600(type="button")
                                //- Icono Ojo Abierto
                                svg#eyeIcon.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg")
                                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")
                                //- Icono Ojo Tachado (Oculto por defecto)
                                svg#eyeOffIcon.w-5.h-5.hidden(fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg")
                                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908A9.954 9.954 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m-1.222-1.84a3 3 0 01-4.243-4.243")
                    div.flex.items-center.justify-between
                       a.text-gray-500.text-xs(href="/auth/registro") ¿No tienes cuenta? Crear Cuenta  
                       a.text-gray-500.text-xs(href="/auth/olvide-password") Olvidé mi Contraseña
                    input(class= "w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 cursor-pointer" type="submit" value="Iniciar Sesión")

block scripts
    script(src="/src/js/login.js")