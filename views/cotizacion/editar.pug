extends ../layout/index

block contenido 
    h2.text-center.text-2xl.font-extrabold.my-6= pagina
    //- BUSCADOR
    div(class="mx-auto max-w-4xl px-4 mb-10")
        form(action=`/cotizacion/editar/${id}` method="GET" class="flex flex-col md:flex-row gap-3 items-center justify-center p-4 rounded-xl shadow-lg bg-white")
            label(for="termino" class="text-sm uppercase font-bold whitespace-nowrap") Búsqueda
            input(
                type="text" 
                id="termino" 
                name="termino" 
                placeholder="Buscar Artículo..." 
                class="flex-1 p-3 uppercase rounded-lg shadow-inner text-sm w-full focus:outline-none focus:ring-2 focus:ring-red-500 border border-gray-200"
            )
            input(
                type="submit" 
                class="w-full md:w-auto bg-gray-600 hover:bg-gray-700 transition-colors rounded-lg text-white uppercase font-bold px-6 py-3 cursor-pointer text-sm shadow-md" 
                value="Buscar"
            )
    //pre=JSON.stringify(cotizacion, null, 2)
    //- GRID PRINCIPAL
    //pre=JSON.stringify(cotizacion, null,2)
    div(class="w-full px-2") 
        div(class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start")
            
            //- COLUMNA IZQUIERDA: Listado (7 de 12)
            div(class="lg:col-span-7")
                div(class="bg-white p-4 rounded-lg shadow-xl border-t-4 border-red-600 min-w-full")
                    h3.text-xl.font-bold.mb-4 Listado de Productos
                div
                    table.min-w-full.bg-white.shadow-md.rounded-lg
                        thead.bg-gray-600.text-white
                            tr
                                th.p-3.text-left
                                    a(href=`?sort=CLAVE_ARTICULO&order=${sort === 'CLAVE_ARTICULO' && order === 'ASC' ? 'DESC' : 'ASC'}` class="hover:underline") Clave
                                th.p-3.text-center
                                    a(href=`?sort=CLAVE_ARTICULO&order=${sort === 'CLAVE_ARTICULO' && order === 'ASC' ? 'DESC' : 'ASC'}` class="hover:underline") Ver
                                th.p-3.text-left
                                    a(href=`?sort=NOMBRE&order=${sort === 'NOMBRE' && order === 'ASC' ? 'DESC' : 'ASC'}` class="hover:underline") Nombre

                                th.p-3.text-left
                                    a(href=`?sort=TOTAL_EXISTENCIA&order=${sort === 'TOTAL_EXISTENCIA' && order === 'ASC' ? 'DESC' : 'ASC'}` class="hover:underline") Existencia
                                th.p-3.text-left
                                    a(href=`?sort=PrecioNeto&order=${sort === 'PrecioNeto' && order === 'ASC' ? 'DESC' : 'ASC'}` class="hover:underline") PRECIO

                                th.p-3.text-center Acciones
                        tbody
                            each codigo in codigos
                                tr.border-b.hover_bg-gray-50
                                    // 1. Identificador
                                    td.p-3.font-medium.text-gray-700= codigo.CLAVE_ARTICULO
                                    
                                    //- Opcion 1: Botón de vista previa con atributo data-img
                                    td.p-3.text-center
                                        button(
                                            type="button"
                                            class="btn-preview p-1.5 rounded-full hover:bg-gray-200 text-gray-500 hover:text-red-600 transition-colors"
                                            data-nombre=codigo.NOMBRE
                                            data-caja=codigo.CONTENIDO_CAJA
                                            data-img=`/uploads/productos/${codigo.CLAVE_ARTICULO}_1.webp`
                                        )
                                            stroke
                                            svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                                                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                                                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")
                                    // 2. Descripción (ancho flexible)
                                    td.p-3.text-base.text-gray-600= codigo.NOMBRE
                                    
                                    // 3. Stock (Alineado al centro para que no se pierda)
                                    td.p-3.text-center.text-base
                                        span(class=[ "font-medium", codigo.TOTAL_EXISTENCIA > 0 ? 'text-green-600' : 'text-red-600'])
                                            | #{codigo.TOTAL_EXISTENCIA}
                                    
                                    // 4. PRECIO (Alineado a la derecha suele verse mejor con dinero)
                                    td.p-3.font-bold.text-blue-700.text-base $#{codigo.PRECIO}
                                    
                                    // 5. Acción
                                    td.p-3.text-right.relative.group
                                        form(action="/cotizacion/agregar" method="POST" class="flex items-center justify-end gap-2")
                                            input(type="hidden" name="_csrf" value=csrfToken)
                                            input(type="hidden" name="articuloId" value=codigo.ART_ID)
                                            if(termino)
                                                input(type="hidden" name="termino" value=termino)
                                            input(
                                                type="number"
                                                name="CANTIDAD"
                                                min="1"
                                                max= codigo.TOTAL_EXISTENCIA
                                                value="1"
                                                onkeydown="return false"
                                                class="w-16 border rounded text-center p-1 focus:ring-2 focus:ring-green-500 outline-none font-base"
                                            )
                                            button(
                                                type="submit"
                                                class="flex flex-shrink-0 w-11 h-10 items-center justify-center bg-green-600 hover:bg-green-700 text-white p-2 rounded transition-transform active:scale-95 shadow-sm"
                                                title="Agregar a la cotización"
                                            )
                                                img(src="/uploads/add.png" class="h-6 w-6 invert")
                                            //- Este es el recuadro que se expande al hacer hover
                                        div(class="hidden group-hover:block absolute z-[100] right-full top-0 mr-4 w-72 bg-white shadow-2xl border border-gray-200 p-4 rounded-xl pointer-events-none")
                                            h4(class="font-bold text-sm mb-2 text-gray-800 border-b pb-1")= codigo.NOMBRE 
                                            h4(class="font-bold text-sm mb-2 text-gray-800 border-b pb-1") Contenido de la caja: 
                                                span(class="text-sm text-gray-600")= codigo.CONTENIDO_CAJA 
                                                    span(class="font-bold")  Piezas

                            else
                                tr
                                    td.py-10.text-center.text-gray-500(colspan="5") No hay productos disponibles
                
                //- Paginación
                div(class="hidden md:block")
                    p(class="text-sm text-center text-gray-600 my-3")
                        | Mostrando 
                        span(class="font-bold text-gray-900") #{offset + 1}
                        |  a 
                        span(class="font-bold text-gray-900") #{total < limit + offset ? total : limit + offset}
                        |  de 
                        span(class="font-bold text-gray-900") #{total}
                        |  productos

                //- pre= JSON.stringify({'paginaActual': paginaActual, 'paginas': paginas, 'offset': offset, 'total': total, 'limit': limit}, undefined, 2)
                nav(class="flex flex-wrap justify-center space-x-1 mb-5" aria-label="Pagination")
                    
                    //- << IR AL INICIO
                    a(href=`/cotizacion/editar?pagina=1${termino ? '&termino='+termino : ''}` 
                    class=`p-2 min-w-[40px] h-10 flex items-center justify-center rounded border border-gray-300 bg-white text-gray-500 hover:bg-red-50 hover:border-red-500 hover:text-red-600 transition-colors ${paginaActual === 1 ? 'opacity-30 pointer-events-none' : ''}`)
                        svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7")

                    //- < ANTERIOR (Flecha individual)
                    a(href=`/cotizacion/editar?pagina=${paginaActual - 1}${termino ? '&termino='+termino : ''}` 
                    class=`p-2 min-w-[40px] h-10 flex items-center justify-center rounded border border-gray-300 bg-white text-gray-500 hover:bg-red-50 hover:border-red-500 hover:text-red-600 transition-colors ${paginaActual === 1 ? 'opacity-30 pointer-events-none' : ''}`)
                        svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7")

                    //- NÚMEROS (CUADRITOS)
                    - const maxPaginas = 5 
                    - let inicio = Math.max(1, paginaActual - 2)
                    - let fin = Math.min(paginas, inicio + 4)
                    - if (fin - inicio < 4) inicio = Math.max(1, fin - 4)

                    - for (let i = inicio; i <= fin; i++)
                        a(href=`/cotizacion/editar?pagina=${i}${termino ? '&termino='+termino : ''}` 
                        class=`w-10 h-10 flex items-center justify-center rounded border text-sm font-bold transition-all ${paginaActual === i ? 'bg-red-600 border-red-600 text-white shadow-md scale-105' : 'bg-white border-gray-300 text-gray-700 hover:border-red-500 hover:text-red-600'}`) #{i}

                    //- > SIGUIENTE (Flecha individual)
                    a(href=`/cotizacion/editar?pagina=${paginaActual + 1}${termino ? '&termino='+termino : ''}` 
                    class=`p-2 min-w-[40px] h-10 flex items-center justify-center rounded border border-gray-300 bg-white text-gray-500 hover:bg-red-50 hover:border-red-500 hover:text-red-600 transition-colors ${paginaActual === paginas ? 'opacity-30 pointer-events-none' : ''}`)
                        svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7")

                    //- >> IR AL FINAL
                    a(href=`/cotizacion/editar?pagina=${paginas}${termino ? '&termino='+termino : ''}` 
                    class=`p-2 min-w-[40px] h-10 flex items-center justify-center rounded border border-gray-300 bg-white text-gray-500 hover:bg-red-50 hover:border-red-500 hover:text-red-600 transition-colors ${paginaActual === paginas ? 'opacity-30 pointer-events-none' : ''}`)
                        svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7")

            //- COLUMNA DERECHA: ASIDE (5 de 12)
            aside(class="lg:col-span-5")
                div(class="bg-white p-4 rounded-lg shadow-xl border-t-4 border-red-600 w-full")
                    h3.text-xl.font-bold.mb-4 Mi Cotización
                    if cotizacion && cotizacion.length
                        div.overflow-x-auto
                            table(class="w-full text-[11px] table-auto")
                                thead.text-gray-500.border-b.uppercase
                                    tr
                                        th.py-2.text-left Clave
                                        th(class="py-2 text-left pl-3 xl:pl-0") Nombre
                                        th.py-2.text-right Stock
                                        th.py-2.text-right Precio
                                        th.py-2.text-center Cant.
                                        th.py-2.text-right Total
                                        th.py-2
                                tbody
                                    each item in cotizacion
                                        tr.border-b.fila-articulo(
                                            data-art-id=item.ART_ID 
                                            data-clave=item.CLAVE_ARTICULO 
                                            data-PRECIO=item.PRECIO)
                                            td.py-3.text-sm.font-bold= item.CLAVE_ARTICULO
                                            //- Truncar nombre si es muy largo
                                            td(class="py-3 font-medium leading-tight text-xs xl:text-sm max-w-[120px] whitespace-normal pl-3 xl:pl-0")= item.NOMBRE
                                            td(class=[ "py-3 font-medium text-xs lg:text-sm", item.EXISTENCIA < item.CANTIDAD ? "text-red-600 text-right" : "text-green-600 text-right"])= item.EXISTENCIA
                                            //- PRECIO Original (Tachado para que se note el descuento)
                                            td.py-3.text-right.text-blue-600.text-sm.font-medium $#{item.PRECIO_DESCUENTO}
                                            
                                            td.py-3.text-center
                                                form(action="/cotizacion/actualizar-cantidad-editar" method="POST" class="form-actualizar-cantidad")
                                                    input(type="hidden" name="_csrf" value=csrfToken)
                                                    input(type="hidden" name="articuloId" value=item.ART_ID)
                                                    input(
                                                        type="number"
                                                        name="cantidad"
                                                        autocomplete="off"
                                                        min="1"
                                                        max= item.EXISTENCIA
                                                        value= item.CANTIDAD
                                                        class="input-cantidad w-16 border rounded text-center p-1 text-sm font-semibold"
                                                    )
                                                //span.px-2.py-1.bg-gray-100.rounded.border= item.CANTIDAD
                                                //input.CANTIDAD(type="hidden" value=item.CANTIDAD)
                                            //- Precio Final (El que paga)
                                            td.py-3.text-right.font-bold.text-red-600 $#{item.IMPORTE_TOTAL}
                                            
                                            td.py-3.text-right.font-bold.text-green-600.text-sm $#{item.IMPORTE_TOTAL}
                                            
                                            td.py-3.text-right
                                                form(action="/cotizacion/eliminar-producto-edit" method="POST")
                                                    input(type="hidden" name="_csrf" value=csrfToken)
                                                    input(type="hidden" name="articuloId" value=item.ART_ID)
                                                    button(type="submit" class="text-gray-500 hover:text-red-800 transition-colors" title="Eliminar de la cotización")
                                                        svg(xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                                                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16")
                    
                        div.mt-4.pt-4.border-t
                            div.flex.justify-between.items-center
                                span.text-gray-600 Total:
                                span.text-2xl.font-black.text-green-600 $#{totalCot}
                            form(action="/cotizacion/guardar" method="POST")
                                input(type="hidden" name="_csrf" value=csrfToken)
                                button(type="submit" class="mt-4 w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-lg shadow-md uppercase text-sm") Guardar Cotización
                    else
                        div.py-10.text-center
                            p.text-gray-500 No hay productos agregados

    div#previewModal(class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4")
        div.bg-white.rounded-2xl.shadow-2xl.max-w-sm.w-full.p-5.relative.animate-fade-in
            button#closePreview(class="absolute top-3 right-3 text-gray-400 hover:text-gray-700 p-1 rounded-full")
                svg.w-6.h-6(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")
            
            //- Contenedor de la Imagen
            div.w-full.h-48.bg-gray-100.rounded-xl.mb-4.overflow-hidden.flex.items-center.justify-center
                img#previewImg(src="" alt="Producto" class="max-h-full max-w-full object-contain p-2" loading="lazy")
                div#imgLoader(class="hidden text-gray-400 text-xs") Cargando imagen...
                
            h4#previewTitle.font-bold.text-gray-800.text-base.mb-2
            div.text-sm.text-gray-600.bg-gray-50.p-2.rounded-lg
                span.font-semibold Contenido de la caja: 
                span#previewCaja 
                span.font-bold.ml-1 Piezas
block scripts
    script(src="/src/js/updater.js")